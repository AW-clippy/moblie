# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Keep only public API classes (not internal implementation)
-keep public class com.awclippy.android.ClipboardSyncService
-keep public class com.awclippy.android.ClipboardAccessibilityService
-keep public class com.awclippy.android.MainActivity
-keep public class com.awclippy.android.ProcessTextActivity

# Keep Service lifecycle methods
-keepclassmembers class * extends android.app.Service {
    public <init>(...);
    public android.os.IBinder onBind(...);
    public void onCreate();
    public int onStartCommand(...);
    public void onDestroy();
}

# Keep Accessibility Service methods
-keepclassmembers class * extends android.accessibilityservice.AccessibilityService {
    public void onAccessibilityEvent(...);
    public void onInterrupt();
    public void onServiceConnected();
}

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}