# AWClippy Android Configuration
# Copy this file to .env and set your values

# Shared secret key for encryption (32 characters recommended)
# MUST match the secret in windows/.env
AWCLIPPY_SHARED_SECRET=CHANGE_THIS_TO_YOUR_SECRET_KEY!!

# Network ports (default values)
AWCLIPPY_DISCOVERY_PORT=48899
AWCLIPPY_SYNC_PORT=48900
